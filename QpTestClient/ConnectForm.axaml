<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QpTestClient.ConnectForm"
        Title="添加连接"
        Width="600" Height="800"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SemiColorBackground}">
    <DockPanel Margin="20">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="15" Margin="0,20,0,0">
            <Button Content="确定(_O)" Width="120" Height="35" Click="BtnOk_Click"
                    Theme="{DynamicResource SolidButton}" />
            <Button Content="取消(_C)" Width="120" Height="35" Click="BtnCancel_Click" />
        </StackPanel>

        <!-- 主内容 -->
        <ScrollViewer>
            <StackPanel Spacing="15">
                <!-- 名称 -->
                <DockPanel>
                    <TextBlock Text="名称:" Width="120" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBox x:Name="TxtName" />
                </DockPanel>

                <!-- 连接方式 -->
                <DockPanel>
                    <TextBlock Text="连接方式:" Width="120" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <ComboBox x:Name="CbConnectType" SelectionChanged="CbConnectType_SelectionChanged" />
                </DockPanel>

                <!-- 属性面板 -->
                <Border x:Name="PnlClientOptions"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="8" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
