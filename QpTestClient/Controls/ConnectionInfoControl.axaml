<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QpTestClient.Controls.ConnectionInfoControl"
             Background="{DynamicResource SemiColorBackground}">
    <TabControl>
        <TabItem Header="基本">
            <Border x:Name="TpBasic" Padding="4" />
        </TabItem>
        <TabItem Header="网络统计">
            <TextBox x:Name="TxtNetstat" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Margin="4" />
        </TabItem>
    </TabControl>
</UserControl>
