<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QpTestClient.Controls.NoticeInfoControl"
             Background="{DynamicResource SemiColorBackground}">
    <TabControl>
        <TabItem Header="基本">
            <TextBox x:Name="TxtBasic" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Margin="4" />
        </TabItem>
        <TabItem Header="示例">
            <TextBox x:Name="TxtSchemaSample" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Margin="4" />
        </TabItem>
    </TabControl>
</UserControl>
