<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QpTestClient.Forms.CommandTestForm"
        Title="命令测试"
        Width="650" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SemiColorBackground}">
    <DockPanel Margin="12">
        <!-- 顶部输入区 -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="窗口标题:" Width="100" VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText0}" />
                <TextBox x:Name="TxtFormTitle" TextChanged="TxtFormTitle_TextChanged" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="命令请求类型:" Width="100" VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText0}" />
                <TextBox x:Name="TxtCommandRequestTypeName" />
            </DockPanel>
            <Button Content="发送" Width="100" Height="30" HorizontalAlignment="Left"
                    x:Name="BtnSend" Click="BtnSend_Click"
                    Theme="{DynamicResource SolidButton}" />
        </StackPanel>

        <!-- 请求/响应区 -->
        <Grid RowDefinitions="*,6,*">
            <!-- 请求内容 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="请求内容" FontWeight="Bold" Margin="0,0,0,8"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBox x:Name="TxtTestRequest"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource SemiColorBorder}" />

            <!-- 结果 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="结果" FontWeight="Bold" Margin="0,0,0,8"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBox x:Name="TxtTestResponse" IsReadOnly="True"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
