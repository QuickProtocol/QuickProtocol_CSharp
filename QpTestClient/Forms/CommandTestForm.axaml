<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QpTestClient.Forms.CommandTestForm"
        Title="命令测试"
        Width="650" Height="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <!-- 顶部输入区 -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="窗口标题:" Width="100" VerticalAlignment="Center" />
                <TextBox x:Name="TxtFormTitle" TextChanged="TxtFormTitle_TextChanged" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="命令请求类型:" Width="100" VerticalAlignment="Center" />
                <TextBox x:Name="TxtCommandRequestTypeName" />
            </DockPanel>
            <Button Content="发送" Width="100" Height="30" HorizontalAlignment="Left"
                    x:Name="BtnSend" Click="BtnSend_Click" />
        </StackPanel>

        <!-- 请求/响应区 -->
        <Grid RowDefinitions="*,6,*">
            <!-- 请求内容 -->
            <HeaderedContentControl Grid.Row="0" Header="请求内容">
                <TextBox x:Name="TxtTestRequest" AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </HeaderedContentControl>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

            <!-- 结果 -->
            <HeaderedContentControl Grid.Row="2" Header="结果">
                <TextBox x:Name="TxtTestResponse" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</Window>
